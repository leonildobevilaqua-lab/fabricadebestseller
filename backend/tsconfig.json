{
    "compilerOptions": {
        "target": "es2016",
        "module": "node16",
        "moduleResolution": "node16",
        "outDir": "./dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "exclude": [
        "checkData.ts",
        "recover_user.ts",
        "recreate_user.ts",
        "internal_api_files",
        "dist",
        "node_modules"
    ]
}